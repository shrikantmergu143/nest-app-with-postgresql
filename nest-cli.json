{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "assets": [
    {
      "include": "src/views/**/*",
      "outDir": "dist/views"
    }
  ],
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": ["**/*.ejs", "**/*.sql", "**/*.base64"]
  }
}
