{
  "name": "nest-app-with-postgres",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:serve": "env-cmd -f .env  nest build",
    "build": "nest build",
    "build:production": "env-cmd -f .env.production nest build",
    "build:development": "env-cmd -f .env.development nest build",
    "build:staging": "env-cmd -f .env.staging nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:prod": "node dist/src/main",
    "start:dev": "env-cmd -f .env nest start --watch",
    "start:dev:staging": "env-cmd -f .env.staging nest start --watch",
    "start:dev:production": "env-cmd -f .env.production nest start --watch",
    "start:dev:development": "env-cmd -f .env.development nest start --watch",
    "start:debug": "env-cmd -f .env nest start --debug --watch",
    "start": "env-cmd -f .env nest start",
    "start:staging": "env-cmd -f .env.staging node dist/src/main",
    "start:production": "env-cmd -f .env.production node dist/src/main",
    "start:development": "env-cmd -f .env.development node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm_temp": "npm run build && npx typeorm -d dist/data-source.js",
    "migrate": "npm run build && npm run typeorm migration:generate",
    "migrate:up": "npm run typeorm migration:run -d config/data-source.ts",
    "migration": "env-cmd -f .env npm run migrate",
    "migration:up": "env-cmd -f .env npm run migrate:up",
    "migration:development": "env-cmd -f .env.development npm run migrate",
    "migration:up:development": "env-cmd -f .env.development npm run migrate:up",
    "migration:generate:development": "env-cmd -f .env.development npm run migrate",
    "migration:staging": "env-cmd -f .env.staging npm run migrate",
    "migration:up:staging": "env-cmd -f .env.staging npm run migrate:up",
    "migration:generate:staging": "env-cmd -f .env.staging npm run migrate",
    "migration:production": "env-cmd -f .env.production npm run migrate",
    "migration:up:production": "env-cmd -f .env.production npm run migrate:up",
    "build:react": "vite build --config src/react-app/vite.config.mts",
    "start:react": "npm run build:react && nest start",
    "typeorm": "typeorm-ts-node-commonjs -d config/data-source.ts",
    "migrate:generate": "npm run typeorm -- migration:generate",
    "migrate:run": "npm run typeorm -- migration:run",
    "migrate:revert": "npm run typeorm -- migration:revert",
    "migration:generate": "env-cmd -f .env npm run migrate:generate",
    "migration:run": "env-cmd -f .env npm run migrate:run",
    "migration:revert": "env-cmd -f .env npm run migrate:revert",
    "migration:generate:production": "env-cmd -f .env.production npm run migrate:generate",
    "migration:run:production": "env-cmd -f .env.production npm run migrate:run",
    "migration:revert:production": "env-cmd -f .env.production npm run migrate:revert"
  },
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.2.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^13.2.4",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "env-cmd": "^11.0.0",
    "graphql": "^16.13.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "pug": "^3.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.27",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "bcrypt": "^6.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.3.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
